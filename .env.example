# Copy to .env to run the site locally, and set all four in Vercel.
#
# These are public values — a Sanity project id and dataset name are visible in
# every browser request the site makes, and the dataset is public and read-only.
# They live here rather than in source so a different project or dataset can be
# pointed at without a code change.
#
# There is no token, and there must never be one: the frontend only ever reads.

VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# The site's own public origin, no trailing slash. Vite substitutes this
# into index.html, where og:image and og:url have to be absolute URLs —
# relative ones are unreliable across link-preview scrapers.
# Set this in Vercel to the production domain.
VITE_SITE_URL=https://your-domain.example

# --- Contact form (server-side only) -----------------------------------------
# NOTE the missing VITE_ prefix. That is deliberate: Vite inlines every VITE_*
# variable into the browser bundle, so a key named VITE_ANYTHING is public.
# These are read by api/contact.js and never reach the client.
# Set them in Vercel, never in this repository.

# Which provider sends the mail: web3forms (no domain needed) or resend.
CONTACT_MAILER=web3forms

# Web3Forms: create a key against DG Events' existing inbox. The destination is
# fixed to that address, so it cannot be redirected by tampering.
WEB3FORMS_ACCESS_KEY=

# Resend: only once a DNS-verified sending domain exists. Switching is setting
# CONTACT_MAILER=resend and filling these three in — no code change.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@your-domain.example
CONTACT_TO_EMAIL=dormiguideevents@gmail.com

# Rate limiting. Plain HTTPS, so it works unchanged on Vercel or Cloudflare.
# If these are unset the form still works — rate limiting just does not apply.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
